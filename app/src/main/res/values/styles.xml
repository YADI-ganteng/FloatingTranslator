<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base application theme -->
    <style name="Theme.FloatingTranslator" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryDark">@color/primary_dark</item>
        <item name="colorAccent">@color/accent</item>
    </style>
    
    <!-- Button styles -->
    <style name="Widget.FloatingTranslator.Button.Primary" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/primary</item>
        <item name="textColor">@color/white</item>
        <item name="cornerRadius">8dp</item>
    </style>
    
    <style name="Widget.FloatingTranslator.Button.Success" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">#4CAF50</item>
        <item name="textColor">@color/white</item>
        <item name="cornerRadius">8dp</item>
    </style>
    
    <style name="Widget.FloatingTranslator.Button.Danger" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">#f44336</item>
        <item name="textColor">@color/white</item>
        <item name="cornerRadius">8dp</item>
    </style>
</resources>
